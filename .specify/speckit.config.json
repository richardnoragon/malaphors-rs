  "configuration": {
    "auto_initialize": true,
    "preserve_history": true,
    "enable_collaboration": true,
    "draft_mode_default": false,
    "strict_validation": true
  },
  "paths": {
    "features_dir": ".specify/features",
    "memory_dir": ".specify/memory",
    "templates_dir": ".specify/templates",
    "extensions_file": ".specify/extensions.yml",
    "constitution_file": ".specify/memory/constitution.md"
  }
