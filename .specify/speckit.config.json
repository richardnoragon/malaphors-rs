    "language": "Python",
    "python_version": "3.10+",
    "repository": "https://github.com/richardnoragon/malaphors-rs.git"
  },
  "capabilities": {
    "agents": [
      "speckit.analyze",
      "speckit.checklist",
      "speckit.clarify",
      "speckit.constitution",
      "speckit.converge",
      "speckit.implement",
      "speckit.plan",
      "speckit.specify",
      "speckit.tasks",
      "speckit.taskstoissues"
